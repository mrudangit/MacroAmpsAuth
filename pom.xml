<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Current GA release (checked at https://start.spring.io/metadata/client). -->
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>amps-auth-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>amps-auth-service</name>
  <description>Authentication web service for the AMPS RESTful Authentication and Entitlement module</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      The feature package: one flat folder (src/main/java/com/example/ampsauth) holding every AMPS
      authentication class, so it can be copied into another application as a unit. The value is
      substituted into application-local.yml by Maven resource filtering (Spring Boot's parent
      enables @..@ filtering for application*.yml). To rename the package: change this value and let
      the IDE "rename package" refactoring move the folders under src/main/java and src/test/java.
      The standalone runner (com.example.AmpsAuthApplication) sits one level above it.
    -->
    <base.package>com.example.ampsauth</base.package>
  </properties>

  <dependencies>
    <!-- Spring MVC + embedded Tomcat. In Spring Boot 4 this starter replaced spring-boot-starter-web
         (the old name still exists but is deprecated in favour of this one). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- PasswordEncoder / bcrypt only. Deliberately NOT spring-boot-starter-security: its
         auto-configuration (login page, CSRF, 401 on bad credentials) contradicts the AMPS contract. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Loaded as -javaagent for Mockito's inline mock maker (see surefire argLine) so that the
         JDK does not have to self-attach an agent at runtime. -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Executable jar: target/amps-auth-service.jar -->
    <finalName>amps-auth-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Exposes ${net.bytebuddy:byte-buddy-agent:jar} for the surefire argLine below. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- quoted so a local repository path containing spaces still works -->
          <argLine>"-javaagent:${net.bytebuddy:byte-buddy-agent:jar}" -Xshare:off</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
