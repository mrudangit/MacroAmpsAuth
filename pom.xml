<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Current GA release (checked at https://start.spring.io/metadata/client). -->
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>amps-auth-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>amps-auth-service</name>
  <description>Authentication web service for the AMPS RESTful Authentication and Entitlement module</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      The feature package: one flat folder (src/main/java/com/example/ampsauth) holding every AMPS
      authentication class, so it can be copied into another application as a unit. The value is
      substituted into application-local.yml by Maven resource filtering (Spring Boot's parent
      enables @..@ filtering for application*.yml). To rename the package: change this value and let
      the IDE "rename package" refactoring move the folders under src/main/java and src/test/java.
      The standalone runner (com.example.AmpsAuthApplication) sits one level above it.
    -->
    <base.package>com.example.ampsauth</base.package>
  </properties>

  <dependencies>
    <!-- Spring MVC + embedded Tomcat (Spring Boot 4's name for the former spring-boot-starter-web). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Swagger UI / OpenAPI for testing the API by hand. Off by default; switched on by the
         springdoc.* properties (see application-local.yml). Only com.example.OpenApiConfiguration
         uses it, so the copyable feature package stays free of this dependency. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <!-- The tests use fakes and a local stub server, not Mockito. Leaving Mockito out also keeps
           Spring Boot's test listeners from self-attaching the byte-buddy agent (a JDK warning). -->
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <!-- Executable jar: target/amps-auth-service.jar -->
    <finalName>amps-auth-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
